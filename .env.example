# ──────────────────────────────────────────────
# Nirmaan x402 — Environment Variables
# Copy this to .env.local and fill in your keys
# ──────────────────────────────────────────────

# ─── x402 / Coinbase Developer Platform ──────
# Get from: https://cdp.coinbase.com
NEXT_PUBLIC_X402_WALLET_ADDRESS=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ─── Google Gemini AI ────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Supabase ────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Smart Contract (Base Sepolia) ───────────
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=84532

# ─── Upstash Redis (optional) ────────────────
# Get from: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
